<footer class="site-footer">
    <div class="container site-footer__inner">
        <p class="site-footer__name">{{ 'site.name'|trans }}</p>
        <p class="site-footer__note">{{ 'footer.demo_note'|trans }}</p>
        <p class="site-footer__meta">
            <span>© {{ 'now'|date('Y') }} {{ 'site.name'|trans }}</span>
            <a class="site-footer__link" href="https://github.com/arbnorhajdini/campus-pimcore">{{ 'footer.source'|trans }}</a>
        </p>
    </div>
</footer>
