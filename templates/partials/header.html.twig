{# Expects: languageRoot (document), navActive (document or null) #}
{% set navigation = opendxp_build_nav({root: languageRoot, active: navActive}) %}

<header class="site-header">
    <div class="container site-header__inner">
        <a class="site-header__brand" href="{{ languageRoot.fullPath }}">
            <span class="site-header__logo" aria-hidden="true">CZ</span>
            <span class="site-header__name">{{ 'site.name'|trans }}</span>
        </a>

        <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
            <span class="site-header__toggle-icon" aria-hidden="true"></span>
            <span class="visually-hidden">{{ 'nav.menu'|trans }}</span>
        </button>

        <div class="site-header__menu" id="site-nav" data-nav>
            <nav class="site-nav" aria-label="{{ 'nav.main'|trans }}">
                <ul class="site-nav__list">
                    {% for page in navigation %}
                        {% if page.visible %}
                            <li class="site-nav__item">
                                <a class="site-nav__link" href="{{ page.uri }}"{% if page.active(true) %} aria-current="page"{% endif %}>
                                    {{- page.label -}}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </nav>

            {{ include('partials/language-switch.html.twig') }}
        </div>
    </div>
</header>
