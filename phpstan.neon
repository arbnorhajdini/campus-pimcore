includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 6
    paths:
        - src
        - tests
    scanFiles:
        - vendor/open-dxp/opendxp/stubs/dynamic-constants.php
    symfony:
        containerXmlPath: var/cache/test/TestContainerDebug.xml
